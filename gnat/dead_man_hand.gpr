with "../config/dead_man_hand_config.gpr";
project Dead_Man_Hand is

   for Source_Dirs use ("../source/", "../config/");
   for Object_Dir use "../obj/" & Dead_Man_Hand_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../bin";
   for Main use ("dead_man_hand-driver.adb");

   package Compiler is
      for Default_Switches ("Ada") use Dead_Man_Hand_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Executable ("dead_man_hand-driver.adb") use "dead_man_hand";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Dead_Man_Hand;
